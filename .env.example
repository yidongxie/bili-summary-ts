# BiliStudy server configuration
# Copy this file to .env and adjust values for your deployment.

PORT=8080
HOST=0.0.0.0
BASE_URL=http://127.0.0.1:8080

# REQUIRED in production — generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=
ENCRYPTION_KEY=

# Admin user bootstrap (email of the initial admin account)
ADMIN_EMAIL=

# GitHub OAuth (optional, for GitHub login)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# WeChat Mini Program (required for mini program login)
WECHAT_APPID=
WECHAT_APPSECRET=

# External binary paths (optional overrides)
YT_DLP_PATH=
YT_DLP_COOKIES_FILE=
YT_DLP_BROWSER_COOKIES=
FFMPEG_PATH=

# Usage limits
MAX_DAILY_SUMMARIES=10
MAX_CONCURRENT_TASKS=2
MAX_AUDIO_DOWNLOAD_BYTES=209715200
MAX_TRANSCRIBE_UPLOAD_BYTES=52428800

# Logging
LOG_LEVEL=info
